# A git install runs a package-manager install inside this package before
# `prepare` — pnpm's preparePackage injects `pm-install` and runs it first
# (pnpm@11.25.0 dist/pnpm.mjs:139396-140400) — and that inner install inherits
# this file. Without it the install fails before the build is ever attempted.
#
# The conflict is not this package's own. @deepseek-ai/dsh-client-runtime@0.1.1-rc.2
# declares peers on @deepseek-ai/dsh-llm@^0.1.1-rc.2 and @deepseek-ai/dsh-agent@^0.1.1-rc.2,
# while this package pins dsh-llm at 0.2.0-rc.2: the published client runtime is
# still on the 0.1.x line while the rest of the harness is on 0.2.x. npm refuses
# that outright; pnpm only warns, because its strict-peer-dependencies default is
# already false. This file makes the two agree so the install does not depend on
# which one pnpm happened to pick.
#
# It also has to reach a git install at all, which is why it lives in the
# repository root rather than in a per-developer location: a registry tarball
# would not carry it, and a git install installs the repository tree as-is.
legacy-peer-deps=true
