# Local development only. This file is never consulted by an installer.
#
# It used to exist for a second reason — a git install used to run an inner
# `npm install` inside this package before `prepare`, and that inner install
# inherited this file — but there is no longer any `prepare`, so pnpm performs
# no preparation step and nothing here reaches a consumer. A registry tarball
# does not carry it either; `files` does not list it.
#
# What remains is the peer conflict this package's own devDependencies have.
# @deepseek-ai/dsh-client-runtime@0.1.1-rc.2 declares peers on
# @deepseek-ai/dsh-llm@^0.1.1-rc.2 and @deepseek-ai/dsh-agent@^0.1.1-rc.2,
# while this package pins dsh-llm at 0.2.0-rc.2: the published client runtime is
# still on the 0.1.x line while the rest of the harness is on 0.2.x. npm refuses
# that outright; pnpm only warns, because its strict-peer-dependencies default is
# already false. This file makes the two agree so a checkout installs with
# whichever one you reach for.
#
# Nothing about the shipped plugin depends on it. The published peers are the
# semver ranges below, and those are what the running harness supplies.
legacy-peer-deps=true
